# Free Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# YouTube Data API key (Google Cloud console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=
# Kaggle: new-style token (Settings -> API -> Generate New Token), plus your username
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
# or the legacy key from kaggle.json
# KAGGLE_KEY=
# Optional: Claude for lyrics/storyboards (llm.provider: claude or --llm claude)
ANTHROPIC_API_KEY=
# Optional: ElevenLabs sung vocals (--music elevenlabs)
ELEVENLABS_API_KEY=
# Optional: free Piper TTS vocals for the local music backend
PIPER_VOICE=
